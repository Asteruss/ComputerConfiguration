<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Blue900">#042C53</Color>
    <Color x:Key="Blue800">#0C447C</Color>
    <Color x:Key="Blue600">#185FA5</Color>
    <Color x:Key="Blue400">#378ADD</Color>
    <Color x:Key="Blue200">#85B7EB</Color>
    <Color x:Key="Blue100">#B5D4F4</Color>
    <Color x:Key="Blue50">#E6F1FB</Color>

    <Color x:Key="Green800">#27500A</Color>
    <Color x:Key="Green600">#3B6D11</Color>
    <Color x:Key="Green100">#C0DD97</Color>
    <Color x:Key="Green50">#EAF3DE</Color>

    <Color x:Key="Red800">#791F1F</Color>
    <Color x:Key="Red600">#A32D2D</Color>
    <Color x:Key="Red100">#F7C1C1</Color>
    <Color x:Key="Red50">#FCEBEB</Color>

    <Color x:Key="Gray100">#D3D1C7</Color>
    <Color x:Key="Gray50">#F1EFE8</Color>
    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextSecondary">#6B6A66</Color>
    <Color x:Key="BorderDefault">#DADADA</Color>

    <!-- SolidColorBrush из палитры -->
    <SolidColorBrush x:Key="Blue600Brush"    Color="{StaticResource Blue600}"/>
    <SolidColorBrush x:Key="Blue900Brush"    Color="{StaticResource Blue900}"/>
    <SolidColorBrush x:Key="Blue200Brush"    Color="{StaticResource Blue200}"/>
    <SolidColorBrush x:Key="Blue800Brush"    Color="{StaticResource Blue800}"/>
    <SolidColorBrush x:Key="Blue50Brush"     Color="{StaticResource Blue50}"/>
    <SolidColorBrush x:Key="Blue100Brush"    Color="{StaticResource Blue100}"/>
    <SolidColorBrush x:Key="Green600Brush"   Color="{StaticResource Green600}"/>
    <SolidColorBrush x:Key="Green800Brush"   Color="{StaticResource Green800}"/>
    <SolidColorBrush x:Key="Green50Brush"    Color="{StaticResource Green50}"/>
    <SolidColorBrush x:Key="Green100Brush"   Color="{StaticResource Green100}"/>
    <SolidColorBrush x:Key="Red600Brush"     Color="{StaticResource Red600}"/>
    <SolidColorBrush x:Key="Red800Brush"     Color="{StaticResource Red800}"/>
    <SolidColorBrush x:Key="Red50Brush"      Color="{StaticResource Red50}"/>
    <SolidColorBrush x:Key="Red100Brush"     Color="{StaticResource Red100}"/>
    <SolidColorBrush x:Key="Gray50Brush"      Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush"      Color="{StaticResource Gray100}"/>

    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="{StaticResource BorderDefault}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
</ResourceDictionary>