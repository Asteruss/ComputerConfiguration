<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ComputerConfiguration.Styles.Controls">
    <Style TargetType="controls:IconTextButton" BasedOn="{StaticResource iconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:IconTextButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="5">
                        <StackPanel Orientation="Vertical" Margin="{TemplateBinding Padding}">
                            <Image Source="{TemplateBinding Icon}"
                                   Style="{StaticResource Icon}"/>
                            <TextBlock Text="{TemplateBinding Text}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="LightGray"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>