<UserControl x:Class="ComputerConfiguration.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ComputerConfiguration.Views"
             xmlns:model="clr-namespace:ComputerConfiguration.Models.Build"
             xmlns:converters="clr-namespace:ComputerConfiguration.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:ComputerConfiguration.ViewModels"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NotVisibilityConverter x:Key="NotVisibilityConverter"/>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
        <converters:SignConverter x:Key="SignConverter" />
        <DataTemplate x:Key="SingleOptionTemplate" DataType="{x:Type vm:ServiceSelectionViewModel}">
            <StackPanel>
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Service.Name}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MultiOptionTemplate" DataType="{x:Type vm:ServiceSelectionViewModel}">
            <StackPanel>
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Service.Name}" />
                <ListBox ItemsSource="{Binding Options}"
                         SelectedItem="{Binding SelectedOption}"
                         IsEnabled="{Binding IsSelected}"
                         Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                         MaxHeight="120">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Option}" 
                                 GroupName="{Binding AdditionalService.Name}"
                                 IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ListOptionTemplate" DataType="{x:Type vm:ServiceSelectionViewModel}">
            <StackPanel>
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Service.Name}" />
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedOption}"
                          DisplayMemberPath="Option"
                          IsEnabled="{Binding IsSelected}"
                          Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                          SelectedIndex="0" />
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>
    <StackPanel>
        <Grid x:Name="gridMain">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Column="0" 
                          VerticalScrollBarVisibility="Auto"
                          Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
                <StackPanel >
                    <StackPanel>
                        <TextBlock Text="Выбранные компоненты"/>
                        <Border>
                            <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Stretch"
                                            Margin="60,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="5"/>
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0"
                                                   Grid.RowSpan="3"
                                                   Grid.Column="0"
                                                   Source="{Binding Image}"
                                                   Width="40"
                                                   Height="40"/>

                                            <TextBlock Grid.Column="1" Grid.Row="0">
                         <Run Text="{Binding TypeString}" />
                         <Run Text="{Binding Name}" />
                                            </TextBlock>

                                            <TextBlock Text="{Binding Description}" Grid.Column="1" Grid.Row="2"/>

                                            <TextBlock Grid.Column="3" HorizontalAlignment="Right"
                                Grid.Row="0" 
                                Visibility="{Binding IsFake, Converter={StaticResource NotVisibilityConverter}}">
                         <Run Text="{Binding Price, StringFormat= Цена: {0:C}}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Column="3" HorizontalAlignment="Right"
                                Grid.Row="0" 
                                Text="Не для покупки"
                                Visibility="{Binding IsFake, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Separator Grid.Row="3" 
                            Grid.Column="0"
                            Grid.ColumnSpan="3"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                    </StackPanel>

                    <GroupBox Header="Дополнительные услуги">
                        <ItemsControl ItemsSource="{Binding ServiceItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource SingleOptionTemplate}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Service.OptionType}" Value="1">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource MultiOptionTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Service.OptionType}" Value="2">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource ListOptionTemplate}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <StackPanel>
                        <TextBlock Text="Проверка"/>
                        <ItemsControl ItemsSource="{Binding Errors}" Visibility="{Binding IsAnyErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="10*"/>

                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TypeString}" 
                                               Grid.Column="0" />

                                        <TextBlock Text="{Binding Message}" 
                                               Grid.Column="1"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Ошибок не найдено" 
                               Visibility="{Binding IsAnyErrors, Converter={StaticResource NotVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Grid.Row="0"
                    Margin="20,50">
                <StackPanel>
                    <mah:ToggleSwitch IsOn="{Binding UseBonuses}"
                                      IsEnabled="{Binding AuthService.IsAuthenticated}"
                                      OffContent="Получить бонусы"
                                      OnContent="Использовать бонусы" 
                                      Command="{Binding SwitchCommand}">
                    </mah:ToggleSwitch>
                    <TextBlock Visibility="{Binding AuthService.IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text="{Binding UseBonuses, Converter={StaticResource SignConverter}}"/><Run Text="{Binding Bonuses}"/>
                        <Run Text="бонусов"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="{Binding TotalPrice, StringFormat=Итоговая цена: {0:C}}"/>
                    </TextBlock>
                    <Button Content="Заказать"
                            IsEnabled="{Binding IsOrderCreation}"
                            Command="{Binding BuyCommand}"
                            Style="{StaticResource RoundedButtonPrimary}"/>
                </StackPanel>

            </Border>
        </Grid>
    </StackPanel>
</UserControl>
