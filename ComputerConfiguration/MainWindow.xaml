<Window x:Class="ComputerConfiguration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComputerConfiguration"
        xmlns:views="clr-namespace:ComputerConfiguration.Views"
        xmlns:viewModels="clr-namespace:ComputerConfiguration.ViewModels"
        xmlns:converters="clr-namespace:ComputerConfiguration.Converters"
        xmlns:controls="clr-namespace:ComputerConfiguration.Styles.Controls"
        mc:Ignorable="d"
        Title="Сборка компьютера" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CartViewModel}">
            <views:CartView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ComponentSelectionViewModel}">
            <views:ComponentSelectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RegistrationViewModel}">
            <views:RegistrationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <converters:VisibilityConverter x:Key="visibilityConverter"/>
        <converters:BoolToGridWidthConverter x:Key="boolToGridWidthConverter"/>
        <Style TargetType="Control">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
    </Window.Resources>
    <Grid Background="Gray">
        <Grid.ColumnDefinitions>
            <!--<ColumnDefinition Width="{Binding ComputerBuild.IsSelectedAnything, Converter={StaticResource boolToGridWidthConverter}}"/>-->
            <ColumnDefinition Width="0.15*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.15*"/>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="Aqua" Background="IndianRed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.4*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Конфигуратор компьютера 3000" 
                           Grid.Column="0" 
                           FontSize="24" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <controls:IconTextButton Text="Избранное" 
                                             Icon="/Icons/favourite-icon.png"
                                             />
                    <controls:IconTextButton Text="Корзина" 
                                             Icon="/Icons/basket-icon.png"
                                             Command="{Binding GoToCartCommand}"/>
                    <controls:IconTextToggleButton x:Name="btnOpenPopup"
                                                   IsChecked="{Binding IsMenuOpen, Mode=TwoWay}"
                                                   Text="Аккаунт" 
                                                   Icon="/Icons/account-icon.png"/>
                    <Popup IsOpen="{Binding IsMenuOpen}"
                           PlacementTarget="{Binding ElementName=btnOpenPopup}"
                           Placement="Bottom" 
                           StaysOpen="False">
                        <Border>
                            <StackPanel>
                                <StackPanel.Resources>
                                    <DataTemplate x:Key="GuestMenu">
                                        <StackPanel>
                                            <Button Content="Зарегистрироваться"
                                                    Command="{Binding GoToRegisterCommand}"/>
                                            <Button Content="Войти"
                                                    Command="{Binding GoToLoginCommand}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                    <DataTemplate x:Key="AccountMenu">
                                        <StackPanel>
                                            <Button Content="Профиль"/>
                                            <Button Content="Мои адреса"/>
                                            <Button Content="История заказов"/>
                                            <Button Content="Отслеживание заказов"/>
                                            <Button Content="Выход"
                                                    Command="{Binding LogoutCommand}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </StackPanel.Resources>
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource GuestMenu}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AuthService.IsAuthenticated}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource AccountMenu}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                

            </Grid>
        </Border>
        
        <!--<Border Grid.Column="0" Grid.Row="1" Visibility="{Binding ComputerBuild.IsSelectedAnything, Converter={StaticResource visibilityConverter}}">
            <TreeView Margin="2">
                <TreeViewItem Header="Процессор" IsExpanded="{Binding ComputerBuild.IsSelectedCpu}">
                    <TreeViewItem Header="{Binding ComputerBuild.Cpu.Name}"/>
                </TreeViewItem>
                <TreeViewItem Header="Видеокарта" IsExpanded="{Binding ComputerBuild.IsSelectedGpu}">
                    <TreeViewItem Header="{Binding ComputerBuild.Gpu.Name}"/>
                </TreeViewItem>
                <TreeViewItem Header="Матплата" IsExpanded="{Binding ComputerBuild.IsSelectedMotherboard}">
                    <TreeViewItem Header="{Binding ComputerBuild.Motherboard.Name}"/>
                </TreeViewItem>
                <TreeViewItem Header="Оперативная память" IsExpanded="{Binding ComputerBuild.IsSelectedRam}">
                    <TreeViewItem Header="{Binding ComputerBuild.Ram.Name}"/>
                </TreeViewItem>
            </TreeView>
        </Border>-->
        <StackPanel Orientation="Vertical" 
                    Grid.Column="0" 
                    Grid.Row="1" >
            <Button Command="{Binding GoToCpuCatalogCommand}" Content="CPU"/>
            <TextBlock Text="{Binding ComputerBuild.Cpu.Name}"
                       Visibility="{Binding ComputerBuild.IsSelectedCpu, Converter={StaticResource visibilityConverter}}"/>
            <Button Command="{Binding GoToGpuCatalogCommand}" Content="GPU"/>
            <Button Command="{Binding GoToMotherboardCatalogCommand}" Content="Motherboard"/>
            <Button Command="{Binding GoToRamCatalogCommand}" Content="Ram"/>
            <Button Command="{Binding GoToPsuCatalogCommand}" Content="Psu"/>
            <Button Command="{Binding GoToStorageCatalogCommand}" Content="Storages"/>
            <Button Command="{Binding GoToCoolerCatalogCommand}" Content="Cooler"/>
            <Button Command="{Binding GoToCaseCatalogCommand}" Content="Case"/>
        </StackPanel>
        <Border Grid.Column="1" Grid.Row="2" Background="LightBlue">
            <ContentControl Content="{Binding DataContext.NavigationStore.CurrentViewModel, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Border>
    </Grid>
</Window>
